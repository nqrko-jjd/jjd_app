# Copié vers .env au premier lancement. Ne jamais committer .env.
DATABASE_URL=file:./prisma/dev.db
JWT_SECRET=dev-jjd-secret-change-me
PORT=4100
PUBLIC_API_URL=http://localhost:4100
WEB_URL=http://localhost:3100

# Traduction auto FR -> NL/EN. Clé « …:fx » = offre gratuite.
DEEPL_API_KEY=

# Google Calendar (lot 2) — synchro de l'agenda partagé via compte de service
GOOGLE_SA_KEY_FILE=./secrets/google-sa.json
GOOGLE_CALENDAR_ID=

# Ponto Connect (Ibanity) — agrégation bancaire. Voir docs/ponto.md.
# Sans ces valeurs, la connexion bancaire est simplement désactivée.
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_REDIRECT_URI=
PONTO_CERT_FILE=./secrets/ponto-certificate.pem
PONTO_KEY_FILE=./secrets/ponto-private-key.pem
PONTO_KEY_PASSPHRASE=
PONTO_SIGNATURE_KEY_ID=
PONTO_SIGNATURE_KEY_FILE=./secrets/ponto-signature-key.pem
PONTO_SANDBOX=
