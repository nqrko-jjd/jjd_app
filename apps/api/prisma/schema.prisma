// JJD App — schéma de données unique (web bureau, mobile terrain, portail client).
// SQLite en dev ; migrable vers PostgreSQL sans changement de modèle.
// SQLite ne supporte pas les enums Prisma -> les "enums" sont des String,
// validées par les unions de @jjd/shared (voir packages/shared/src/enums.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Compteurs atomiques : numéros de chantier (R-), devis (D-), factures (F-).
model Counter {
  name  String @id
  value Int    @default(0)
}

/// Lien de connexion à usage unique (portail client — pas de mot de passe).
model LoginToken {
  token     String    @id
  email     String
  purpose   String    @default("portal")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

/// Paramètres éconos + coordonnées société, éditables en admin.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Piste d'audit : qui a fait quoi.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String
  entity   String
  entityId String?
  meta     Json?

  @@index([entity, entityId])
  @@index([at])
}

// ─────────────────────────────────────────────────────────── Utilisateurs & équipe

/// Compte de connexion. `role` = admin | office | foreman | worker | client.
/// `isPartner` = David & Julien uniquement (visibilité du partage des bénéfices).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("worker")
  isPartner    Boolean   @default(false)
  locale       String    @default("fr")
  active       Boolean   @default(true)
  personId     String?   @unique
  person       Person?   @relation(fields: [personId], references: [id])
  contactId    String?   @unique // compte client -> voit ses chantiers
  contact      Contact?  @relation("UserClientAccount", fields: [contactId], references: [id])
  syndicId     String? // compte client "syndic" -> voit tous ses immeubles
  syndic       Syndic?   @relation(fields: [syndicId], references: [id])
  residentOfId String? // compte "résident" -> limité à un immeuble/ACP (non unique : plusieurs résidents peuvent partager un immeuble)
  residentOf   Contact?  @relation("ResidentOfAcp", fields: [residentOfId], references: [id])
  portalAccess String    @default("full") // full | limited (limited = suivi/photos/messages, sans devis/factures/montants)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs         AuditLog[]
  approvedEntries   TimeEntry[]        @relation("ApprovedBy")
  ownedOpps         CrmOpportunity[]   @relation("OppOwner")
  createdEvents     PlanningEvent[]    @relation("EventCreatedBy")
  messages          Message[]
  createdDocuments  Document[]         @relation("DocumentAuthor")
  createdLedger     LedgerEntry[]      @relation("LedgerEntryAuthor")
  reports           WorksiteReport[]   @relation("ReportAuthor")
  reviewedReports   WorksiteReport[]   @relation("ReportReviewer")
  createdTasks      WorksiteTask[]     @relation("TaskCreatedBy")
  stockMovements    StockMovement[]    @relation("StockMovementBy")
  personAdjustments PersonAdjustment[] @relation("PersonAdjustmentAuthor")
  threadReads       ThreadRead[]
  mentions          MessageMention[]
  pushSubscriptions PushSubscription[]
}

/// Fiche personne : ouvrier ou chef de chantier. Toutes les infos utiles.
model Person {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String?
  displayName      String? // nom court utilisé sur le terrain / dans le pointage
  normalizedName   String // pour le dédoublonnage
  role             String   @default("worker") // foreman | team_leader | qualified_worker | worker
  contractType     String   @default("employee") // employee | subcontractor | interim
  hourlyRate       Float?
  dailyHours       Float    @default(10) // jour presté garanti (payé même si moins pointé sur chantier)
  phone            String?
  email            String?
  address          String?
  languages        Json? // ["fr","pt","es"]
  specialties      Json? // ["maçon","carreleur","électricien"]
  emergencyContact String?
  active           Boolean  @default(true)
  note             String?
  photoUrl         String?
  photoThumbUrl    String?
  source           String? // "xlsx" | "trustup" | "manual"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user                 User?
  legalDocs            LegalDoc[]
  equipment            Equipment[]
  timeEntries          TimeEntry[]
  managedWorksites     Worksite[]          @relation("WorksiteManager")
  eventAssignments     EventAssignment[]
  teamMemberships      TeamMember[]
  threadParticipations ThreadParticipant[]
  assignedTasks        WorksiteTask[]      @relation("TaskAssignee")
  taskAssignments      TaskAssignment[]
  adjustments          PersonAdjustment[]
  leadEvents           PlanningEvent[]     @relation("EventLead")
  driverEvents         PlanningEvent[]     @relation("EventDriver")
  vehicleDriverLinks   EventVehicle[]      @relation("EventVehicleDriver")
  absences             Absence[]

  @@index([normalizedName])
  @@index([active])
}

/// Avance versée ou dette imputée à un ouvrier (acompte, amende/PV à sa charge…),
/// à déduire de sa prochaine paie. Repère pour le bureau au moment de payer — ne
/// modifie pas le décompte mensuel calculé sur le pointage (heures × taux).
model PersonAdjustment {
  id          String    @id @default(cuid())
  personId    String
  person      Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type        String // advance | debt
  amount      Float
  date        DateTime
  note        String?
  settled     Boolean   @default(false) // déjà déduit de la paie / remboursé
  settledOn   DateTime?
  createdById String?
  createdBy   User?     @relation("PersonAdjustmentAuthor", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([personId])
}

/// Document légal suivi sur une fiche personne (avec échéance -> alerte).
model LegalDoc {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      String // id_card | work_permit | a1 | limosa | vca | driving_license | medical | contract | other
  label     String?
  number    String?
  issuedOn  DateTime?
  expiresOn DateTime?
  fileUrl   String?
  createdAt DateTime  @default(now())

  @@index([expiresOn])
}

/// Matériel confié (léger — inventaire complet plus tard si besoin).
model Equipment {
  id           String   @id @default(cuid())
  name         String
  reference    String?
  assignedToId String?
  assignedTo   Person?  @relation(fields: [assignedToId], references: [id])
  note         String?
  createdAt    DateTime @default(now())

  events EventEquipment[]
}

/// Catalogue des consommables (visserie, ciment, peinture…) utilisés sur les chantiers.
model Consumable {
  id        String   @id @default(cuid())
  name      String
  unit      String   @default("pièce") // pièce | kg | L | m² | sac…
  note      String?
  createdAt DateTime @default(now())

  events EventConsumable[]
}

/// Équipe = préréglage nommé (souvent recomposé au jour le jour via le planning).
model Team {
  id      String          @id @default(cuid())
  name    String
  color   String?
  active  Boolean         @default(true)
  members TeamMember[]
  events  PlanningEvent[]
}

model TeamMember {
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([teamId, personId])
}

// ─────────────────────────────────────────────────────────── Clients & immeubles

/// Syndic (Baltimo, Kadaner, Citya Woluwe…). Regroupe des immeubles / ACP.
model Syndic {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  email          String?
  phone          String?
  address        String?
  city           String?
  note           String?
  createdAt      DateTime @default(now())

  contacts Contact[]
  users    User[]

  @@index([normalizedName])
}

/// Contact : client (particulier, société, ACP, pouvoir public) ou fournisseur.
model Contact {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  type           String   @default("client") // client | supplier | both
  kind           String? // individual | company | acp | syndic | public
  email          String?
  phone          String?
  vat            String?
  address        String?
  postalCode     String?
  city           String?
  syndicId       String?
  syndic         Syndic?  @relation(fields: [syndicId], references: [id])
  note           String?
  trustupId      String?
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Champs propres à un Contact de kind 'acp'/'developer', qui EST la fiche de l'immeuble/
  // projet (adresse d'intervention, digicode, lots...) en plus de son identité de
  // facturation — une ACP n'est plus deux fiches séparées à garder synchronisées.
  reference     String? // n° de dossier syndic / ACP
  lotCount      Int? // nombre de lots dans la copropriété
  digicode      String?
  accessNote    String? // clés, badges, où se garer…
  photoUrl      String?
  photoThumbUrl String?
  // Immeuble/ACP auquel ce contact (une personne : résident, propriétaire...) est
  // rattaché — autoréférence, distinct de `residents` ci-dessous (les contacts rattachés
  // à CE contact quand il est lui-même une ACP).
  linkedAcpId   String?
  linkedAcp     Contact?  @relation("ContactLinkedAcp", fields: [linkedAcpId], references: [id])
  residents     Contact[] @relation("ContactLinkedAcp")

  stockSuppliers   StockSupplier[]   @relation("StockSupplierContact")
  purchaseOrders   PurchaseOrder[]   @relation("PurchaseOrderSupplier")
  stockMovements   StockMovement[]   @relation("StockMovementSupplier")
  user             User?             @relation("UserClientAccount")
  worksites        Worksite[]        @relation("WorksiteClient")
  acpWorksites     Worksite[]        @relation("WorksiteAcp")
  billToWorksites  Worksite[]        @relation("WorksiteBillTo")
  opportunities    CrmOpportunity[]  @relation("CrmOpportunityContact")
  acpOpportunities CrmOpportunity[]  @relation("CrmOpportunityAcp")
  documents        Document[]
  ledgerEntries    LedgerEntry[]
  buildingContacts BuildingContact[] @relation("BuildingContactPerson")
  buildingUnits    BuildingUnit[]    @relation("BuildingUnitOccupant")
  acpKeyContacts   BuildingContact[] @relation("AcpKeyContact")
  acpUnits         BuildingUnit[]    @relation("AcpUnit")
  residentUsers    User[]            @relation("ResidentOfAcp")
  contactPersons   ContactPerson[]

  @@index([normalizedName])
  @@index([type])
}

/// Personne de contact chez ce fournisseur/client (fonction, nom, e-mail, tél) — pour joindre
/// quelqu'un de précis plutôt que le standard (ex. « Comptabilité », « Commercial »).
model ContactPerson {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  role      String? // fonction, texte libre : "Commercial", "Comptabilité", "Direction"…
  name      String
  email     String?
  phone     String?
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
}

/// Contact rattaché à un immeuble/ACP (Contact de kind 'acp'/'developer') : concierge,
/// président d'assemblée, gestionnaire syndic… (texte libre, lien Contact optionnel).
model BuildingContact {
  id        String   @id @default(cuid())
  role      String // concierge | president | council | syndic_manager | contact | owner_rep | other
  name      String
  phone     String?
  email     String?
  note      String?
  contactId String? // lien éventuel vers un Contact existant
  contact   Contact? @relation("BuildingContactPerson", fields: [contactId], references: [id])
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  acpId String
  acp   Contact @relation("AcpKeyContact", fields: [acpId], references: [id], onDelete: Cascade)

  @@index([acpId])
}

/// Personne à joindre pour un chantier précis (demandeur, gestionnaire, propriétaire,
/// locataire, contact sur place, architecte, responsable facturation…) — distinct du
/// client facturé (Worksite.client) et des contacts fixes de l'immeuble (BuildingContact) :
/// propre au dossier, saisi à l'ouverture, peut être plusieurs personnes différentes.
model WorksiteContact {
  id         String   @id @default(cuid())
  role       String // demandeur | gestionnaire | proprietaire | locataire | sur_place | architecte | facturation
  name       String
  phone      String?
  email      String?
  contactFor String? // demande | rdv_acces | suivi_technique | factures | demande_acces_suivi
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worksiteId String
  worksite   Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)

  @@index([worksiteId])
}

/// Lot / appartement d'un immeuble (Contact de kind 'acp'/'developer') + occupant connu.
/// Ex. « Algarve C1 — Mme Pinto — 1er étage — App C ».
model BuildingUnit {
  id            String   @id @default(cuid())
  label         String // "C1", "Lot 12", "2A"
  floor         String? // "1er étage", "RdC"
  door          String? // "App C", "porte gauche"
  contactId     String? // lien vers une vraie fiche Contact (occupant identifié)
  contact       Contact? @relation("BuildingUnitOccupant", fields: [contactId], references: [id])
  occupantName  String? // legacy (texte libre, fiches historiques sans contact lié)
  occupantPhone String?
  occupantEmail String?
  occupantKind  String? // owner | tenant | unknown
  note          String?
  position      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  acpId String
  acp   Contact @relation("AcpUnit", fields: [acpId], references: [id], onDelete: Cascade)

  @@index([acpId])
}

// ─────────────────────────────────────────────────────────── Chantiers & CRM

/// Chantier — le pivot. `ref` = R-xxx (unique, attribué automatiquement).
model Worksite {
  id           String    @id @default(cuid())
  ref          String    @unique
  title        String
  kind         String    @default("project") // project | overhead (codes E-xx : frais sans chantier)
  entity       String    @default("jjd") // jjd | tonton | m7
  status       String    @default("to_plan")
  priority     String    @default("normal") // low | normal | high | urgent
  // Portée et facturation : informatifs, modifiables à tout moment (jamais figés à la
  // création) — une intervention peut grandir en cours de route, et rester en régie ou
  // basculer en devis indépendamment de sa taille. Pas de valeur par défaut : laissés vides
  // (non classés) plutôt que de deviner pour les chantiers déjà existants.
  scope        String? // intervention | long_term
  billingMode  String? // regie | devis | mixte | contrat
  requestKind  String? // ponctuelle | renovation | entretien | sav — nature de la demande à l'ouverture du dossier
  statusRaw    String? // texte d'origine (Excel / TrustUp)
  statusTags   Json? // ["Terminé","A vérifier"]
  clientId     String?
  client       Contact?  @relation("WorksiteClient", fields: [clientId], references: [id])
  acpId        String? // immeuble/ACP où se déroule l'intervention (dérivé du client s'il est ACP)
  acp          Contact?  @relation("WorksiteAcp", fields: [acpId], references: [id])
  managerId    String?
  manager      Person?   @relation("WorksiteManager", fields: [managerId], references: [id])
  billTo       String? // "Facture à" texte libre du fichier (legacy, non rapproché) — remplacé par billToContact pour la saisie
  billToContactId String? // contact réel à facturer si différent du client (par défaut = client)
  billToContact   Contact?  @relation("WorksiteBillTo", fields: [billToContactId], references: [id])
  billToAttn        String? // "À l'attention de / chez" propre à la facturation de ce chantier
  billToEmail       String? // e-mail de facturation si différent de celui du contact facturé
  clientRef         String? // référence client / bon de commande à rappeler sur la facture
  billingCadence    String? // fin_intervention | acompte_avancement_solde | mensuel | contrat
  billingConditions String? // acompte, délai de paiement, validation préalable… (texte libre)
  quoteRef     String? // référence du devis lié, si déjà connue à l'ouverture du dossier
  address      String?
  postalCode   String?
  city         String?
  unitLabel    String? // lot, étage, bâtiment ou zone concernée (immeubles à plusieurs lots)
  accessNotes  String? // accès et prise de rendez-vous — comment/quand intervenir sur place
  startedOn    DateTime?
  endedOn      DateTime?
  lat          Float? // point GPS de référence (capturé au 1er pointage sur place, ajustable)
  lng          Float?
  geoSetAt     DateTime?
  quotedHt     Float? // "Total Devisé"
  description  String?
  // Contacts propres à cette intervention (distincts du client facturé et des
  // contacts fixes de l'immeuble type concierge/syndic) : le propriétaire du lot
  // concerné et le locataire — le syndic transmet ces coordonnées à l'ouverture
  // du dossier, on recontacte le locataire pour le rdv sur place.
  ownerName    String?
  ownerPhone   String?
  ownerEmail   String?
  tenantName   String?
  tenantPhone  String?
  tenantPhone2 String?
  tenantEmail  String?
  trustupId    String?
  source       String?
  archived     Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  documents      Document[]
  ledgerEntries  LedgerEntry[]
  timeEntries    TimeEntry[]
  events         PlanningEvent[]
  opportunity    CrmOpportunity?
  thread         Thread?
  reports        WorksiteReport[]
  tasks          WorksiteTask[]
  taskPhases     WorksiteTaskPhase[]
  stockMovements StockMovement[]
  stockOrders    StockOrder[]    @relation("StockOrderWorksite")
  purchaseOrders PurchaseOrder[] @relation("PurchaseOrderWorksite")
  contacts       WorksiteContact[]

  @@index([status])
  @@index([entity])
  @@index([ref])
}

/// Opportunité commerciale — le pipeline CRM.
model CrmOpportunity {
  id             String    @id @default(cuid())
  title          String
  stage          String    @default("new") // new | to_qualify | visit_scheduled | quote_sent | follow_up | won | lost
  contactId      String?
  contact        Contact?  @relation("CrmOpportunityContact", fields: [contactId], references: [id])
  acpId          String?
  acp            Contact?  @relation("CrmOpportunityAcp", fields: [acpId], references: [id])
  worksiteId     String?   @unique
  worksite       Worksite? @relation(fields: [worksiteId], references: [id])
  ownerId        String?
  owner          User?     @relation("OppOwner", fields: [ownerId], references: [id])
  estimatedValue Float?
  source         String? // "portail" | "site" | "téléphone" | "recommandation"
  nextActionOn   DateTime?
  nextActionNote String?
  lostReason     String?
  note           String?
  // Détails structurés d'une demande d'intervention déposée via le portail (parcours en 4
  // étapes) — nullable : une opportunité créée manuellement par le bureau n'en a pas besoin.
  problemType        String? // fuite | electricite | chauffage | porte | peinture | toiture | autre
  unitLabel          String? // lot / appartement / zone précise
  urgent             Boolean  @default(false)
  urgency            String? // normal | soon | urgent — niveau choisi dans le parcours (urgent = booléen ci-dessus)
  onSiteContactName  String?
  onSiteContactPhone String?
  accessNotes        String?
  visitPreference    String?
  photos             OpportunityPhoto[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage])
  @@index([nextActionOn])
}

/// Photo jointe à une demande d'intervention (déposée via le portail avant même la création
/// du chantier) — même schéma que ReportPhoto.
model OpportunityPhoto {
  id            String         @id @default(cuid())
  opportunityId String
  opportunity   CrmOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  url           String
  thumbUrl      String?
  createdAt     DateTime       @default(now())

  @@index([opportunityId])
}

// ─────────────────────────────────────────────────────────── Facturation & compta

/// Catégorie comptable (codes E-01…E-19 + libellés de charges/revenus).
model Category {
  code   String  @id
  label  String
  kind   String // revenue | expense | salary | vat | tax | credit_note | internal
  entity String? // rattachement éventuel (jjd | tonton | m7)
  active Boolean @default(true)

  ledgerEntries LedgerEntry[]
}

/// En-tête de document commercial : devis, facture, note de crédit, acompte.
/// Source de vérité = TrustUp pour l'instant (import). Le module lot 6 les créera.
model Document {
  id             String            @id @default(cuid())
  kind           String // quote | invoice | credit_note | deposit_invoice
  direction      String            @default("sale") // sale | purchase | credit_note
  number         String? // null tant que le document est en brouillon
  draftRef       String?           @unique // "BROUILLON-xxx" tant que non émis
  worksiteId     String?
  worksite       Worksite?         @relation(fields: [worksiteId], references: [id])
  contactId      String?
  contact        Contact?          @relation(fields: [contactId], references: [id])
  status         String            @default("draft")
  title          String?
  intro          String? // texte d'introduction (devis)
  terms          String? // conditions / mentions de bas de page
  issuedOn       DateTime?
  dueOn          DateTime?
  validUntil     DateTime? // devis : date de validité
  totalHt        Float             @default(0)
  totalVat       Float             @default(0)
  totalTtc       Float             @default(0)
  vatRate        Float?
  paidAmount     Float             @default(0)
  paidOn         DateTime?
  note           String?
  // coordonnées de facturation, éditables indépendamment de la fiche contact/chantier (ex.
  // adresse de facturation différente de l'adresse d'intervention) — servent aussi d'instantané
  // au moment de l'émission, le contact pouvant changer ensuite
  billingName    String?
  billingVat     String?
  billingAddress String?
  billingEmail   String?
  customerRef    String? // référence client / bon de commande, affichée sur le document
  structuredComm String? // communication structurée belge +++xxx/xxxx/xxxxx+++
  peppolStatus   String? // null | queued | sent | delivered | error
  originalPdf    String? // nom de fichier du PDF TrustUp d'origine (uploads/documents/…)
  sentAt         DateTime?
  acceptedOn     DateTime?
  declinedReason String?
  lockedAt       DateTime? // émission = verrou : plus de modif des lignes
  parentId       String?
  parent         Document?         @relation("DocumentLineage", fields: [parentId], references: [id])
  children       Document[]        @relation("DocumentLineage")
  trustupId      String?
  source         String?
  // écriture du grand livre synchronisée automatiquement à l'émission / au paiement
  // (voir syncLedgerEntryForDocument, lib/documents.ts) — remplace le rattrapage manuel
  // pour les documents émis depuis l'appli.
  ledgerEntry    LedgerEntry?
  createdById    String?
  createdBy      User?             @relation("DocumentAuthor", fields: [createdById], references: [id])
  lines          DocumentLine[]
  bankMatches    BankTransaction[] @relation("DocumentBankMatches")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([kind, number])
  @@index([worksiteId])
  @@index([contactId])
  @@index([status])
}

/// Ligne d'un devis / d'une facture.
model DocumentLine {
  id          String     @id @default(cuid())
  documentId  String
  document    Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  position    Int        @default(0)
  kind        String     @default("item") // item | section | text
  label       String
  description String?
  qty         Float      @default(1)
  unit        String? // "m²", "h", "pce", "forfait"
  unitPriceHt Float      @default(0)
  discountPct Float      @default(0)
  vatRate     Float      @default(0.21)
  totalHt     Float      @default(0)
  priceItemId String?
  priceItem   PriceItem? @relation(fields: [priceItemId], references: [id])

  @@index([documentId])
}

/// Bibliothèque d'ouvrages — prix réutilisables pour composer les devis.
model PriceItem {
  id          String   @id @default(cuid())
  ref         String? // code interne éventuel
  label       String
  description String?
  unit        String?
  unitPriceHt Float    @default(0)
  vatRate     Float    @default(0.21)
  category    String? // "Maçonnerie", "Peinture", "Main d'œuvre"…
  active      Boolean  @default(true)
  source      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines DocumentLine[]

  @@index([category])
}

/// Ligne du grand livre = une ligne de l'onglet "Facture" du fichier.
/// C'est la granularité qui alimente la marge réelle (matériaux) et le CA.
model LedgerEntry {
  id            String    @id @default(cuid())
  date          DateTime?
  dueDate       DateTime? // échéance (facture d'achat)
  year          Int?
  month         String?
  direction     String // sale | purchase | credit_note
  docType       String? // "Facture de vente" | "Facture d'achat" | "Note de crédit"
  docNumber     String?
  worksiteRef   String? // R-xxx / E-xx tel qu'écrit
  worksiteId    String?
  worksite      Worksite? @relation(fields: [worksiteId], references: [id])
  supplierName  String?
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  categoryCode  String?
  category      Category? @relation(fields: [categoryCode], references: [code])
  categoryRaw   String?
  ht            Float     @default(0)
  vatRecup      Float?
  vatDue        Float?
  ttc           Float?
  vatRate       Float?
  quarter       String?
  paymentStatus String? // "Payé" | "Non payé" | ...
  paidOn        DateTime? // date de paiement (rapprochement ou saisie manuelle)
  bankComm      String?
  notes         String?
  pdfPath       String? // pièce jointe (PDF ou image), via storeFile -> uploads/expenses/…
  source        String?
  // lien vers le devis/facture/NC de l'appli qui a généré cette écriture (source: "document-sync") —
  // unique : un document ne peut avoir qu'une seule écriture synchronisée, mise à jour en place.
  documentId    String?   @unique
  document      Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdById   String?
  createdBy     User?     @relation("LedgerEntryAuthor", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt

  @@index([worksiteId])
  @@index([worksiteRef])
  @@index([direction])
  @@index([date])
}

/// Import brut des relevés bancaires (Belfius + ING). Rapprochement progressif.
/// Compte bancaire connecté via Ponto (Ibanity) — ou saisi à la main.
model BankAccount {
  id           String            @id @default(cuid())
  externalId   String?           @unique // id du compte côté Ponto
  iban         String?
  label        String?
  currency     String?           @default("EUR")
  balance      Float?
  balanceAt    DateTime?
  lastSyncAt   DateTime?
  syncCursor   String? // pagination Ponto (page[after]) pour la synchro incrémentale
  createdAt    DateTime          @default(now())
  transactions BankTransaction[]

  @@index([iban])
}

model BankTransaction {
  id                  String       @id @default(cuid())
  externalId          String?      @unique // id de la transaction côté Ponto (idempotence)
  accountId           String?
  account             BankAccount? @relation(fields: [accountId], references: [id])
  bookingDate         DateTime?
  bank                String?
  counterpartyAccount String?
  counterpartyName    String?
  description         String?
  valueDate           DateTime?
  amount              Float?
  currency            String?      @default("EUR")
  communication       String?
  structuredComm      String? // communication structurée normalisée (+++xxx/xxxx/xxxxx+++)
  side                String? // "in" (crédit / encaissement) | "out" (débit / paiement)
  matchedLedgerId     String?
  matchedDocumentId   String?
  matchedDocument     Document?    @relation("DocumentBankMatches", fields: [matchedDocumentId], references: [id])
  matchConfidence     String? // "strong" | "good" | "manual"
  matchedAt           DateTime?
  source              String? // "xlsx" | "ponto"
  createdAt           DateTime     @default(now())

  @@index([bookingDate])
  @@index([matchedLedgerId])
  @@index([matchedDocumentId])
}

// ─────────────────────────────────────────────────────────── Pointage & planning

/// Pointage = une ligne de l'onglet "Main doeuvre" / un run du compteur mobile.
model TimeEntry {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id])
  worksiteId    String?
  worksite      Worksite? @relation(fields: [worksiteId], references: [id])
  worksiteRef   String?
  date          DateTime?
  hours         Float?
  amount        Float? // heures × taux, ou saisi à la main
  rateUsed      Float?
  task          String?
  startedAt     DateTime? // compteur mobile
  endedAt       DateTime?
  startLat      Float? // position au démarrage du compteur
  startLng      Float?
  geoDistance   Int? // mètres entre le pointage et le point de référence du chantier
  geoFlag       Boolean   @default(false) // true = pointé hors zone (mode souple : accepté mais signalé)
  status        String    @default("approved") // running | submitted | approved | rejected
  approvedById  String?
  approvedBy    User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  subcontractor String?
  source        String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([personId, date])
  @@index([worksiteId])
  @@index([status])
}

/// Événement de planning : équipe + véhicule affectés à un chantier.
model PlanningEvent {
  id            String   @id @default(cuid())
  worksiteId    String
  worksite      Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  title         String?
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean  @default(false)
  status        String   @default("confirmed") // confirmed | tentative — "à confirmer" (créneau pas encore garanti)
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id])
  vehicleId     String? // legacy, un seul véhicule — conservé pour ne pas perdre les données déjà en prod, plus utilisé par l'appli (voir EventVehicle)
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  leadPersonId  String? // référent de l'intervention (parmi les ouvriers affectés)
  leadPerson    Person?  @relation("EventLead", fields: [leadPersonId], references: [id])
  driverPersonId String? // conducteur du véhicule réservé, si applicable
  driverPerson   Person? @relation("EventDriver", fields: [driverPersonId], references: [id])
  departureAt   DateTime? // heure de départ (dépôt / point de rendez-vous), distincte du début d'intervention
  departureFrom String? // lieu de rendez-vous / départ
  tasksNote     String? // travaux à réaliser sur ce créneau, une tâche par ligne
  accessNote    String? // accès, livraison, protections & consignes propres à ce créneau
  materialsNote String?
  note          String? // contact sur place / coordination + instructions libres pour l'équipe
  googleEventId String?  @unique // UID de l'événement Google Agenda (synchro / import)
  source        String? // "agenda-import" | null (créé dans l'app)
  createdById   String?
  createdBy     User?    @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments EventAssignment[]
  equipment   EventEquipment[]
  consumables EventConsumable[]
  vehicles    EventVehicle[]

  @@index([startAt])
  @@index([worksiteId])
}

/// Absence d'un ouvrier (congé, formation…) — bloque son affectation sur la période, distinct
/// d'une PlanningEvent qui rattache toujours à un chantier.
model Absence {
  id        String   @id @default(cuid())
  personId  String
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  kind      String // leave | training | other
  startsOn  DateTime // jour de début (journée pleine)
  endsOn    DateTime // jour de fin inclus
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([personId])
  @@index([startsOn])
}

model EventAssignment {
  eventId  String
  event    PlanningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId String
  person   Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
}

/// Matériel (outillage, échafaudage…) réservé pour une affectation de planning.
model EventEquipment {
  eventId     String
  event       PlanningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  equipmentId String
  equipment   Equipment     @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@id([eventId, equipmentId])
}

/// Consommables prévus pour une affectation de planning, avec quantité.
model EventConsumable {
  eventId      String
  event        PlanningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumableId String
  consumable   Consumable    @relation(fields: [consumableId], references: [id], onDelete: Cascade)
  qty          Float         @default(1)

  @@id([eventId, consumableId])
}

/// Véhicule(s) affecté(s) à une affectation de planning (plusieurs possibles).
model EventVehicle {
  eventId        String
  event          PlanningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  // conducteur de CE véhicule sur cet événement — plusieurs véhicules = plusieurs conducteurs possibles
  driverPersonId String?
  driver         Person?       @relation("EventVehicleDriver", fields: [driverPersonId], references: [id])

  @@id([eventId, vehicleId])
}

// ─────────────────────────────────────────────────────────── Flotte

model Vehicle {
  id                String    @id @default(cuid())
  code              String?   @unique // V002, V003… (registre JJD)
  plate             String?
  brand             String?
  model             String?
  name              String?
  type              String? // Camionette | Moto | Clark | Voiture
  seats             Int? // nombre de places
  fuel              String?
  vin               String?
  firstRegistration DateTime?
  km                String?
  nextInspection    DateTime?
  circulationTax    Float?
  biv               Float?
  driver            String?
  equipment         String?
  depot             String?
  status            String    @default("active")

  // coût de revient (imputation aux chantiers)
  fuelConsoL100  Float? // consommation moyenne, litres / 100 km
  fuelPricePerL  Float? // prix du carburant, € / litre
  costPerKmExtra Float? // € / km supplémentaire (entretien, pneus, usure)
  parkingMonthly Float? // parking / garage, € / mois
  otherMonthly   Float? // autres frais fixes mensuels (GPS, nettoyage, télépéage…)

  // acquisition / financement
  acquisitionMode String? // Comptant | Crédit | Leasing | Renting financier
  purchaseDate    DateTime?
  purchasePriceHt Float?
  financedAmount  Float?
  monthlyPayment  Float?
  downPayment     Float?
  residualValue   Float?
  financeMonths   Int?
  financeEndOn    DateTime?
  financeCompany  String?
  financeContract String?

  active               Boolean  @default(true)
  excludedFromPlanning Boolean  @default(false) // véhicule perso, chariot élévateur… : pas proposé dans les affectations planning
  note                 String?
  photoUrl             String?
  photoThumbUrl        String?
  source               String?
  createdAt            DateTime @default(now())

  insurances Insurance[]
  fines      Fine[]
  events     PlanningEvent[] // legacy (voir PlanningEvent.vehicleId)
  eventLinks EventVehicle[]
  payments   VehiclePayment[]
  docs       VehicleDoc[]
  repairs    VehicleRepair[]
}

/// Frais de réparation / entretien ponctuel (garage) — distinct des coûts fixes de revient.
model VehicleRepair {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date        DateTime?
  description String?
  garage      String?
  amount      Float?
  km          String?
  createdAt   DateTime  @default(now())

  @@index([vehicleId, date])
}

/// Document véhicule (certificat d'immatriculation, assurance, contrôle technique…).
model VehicleDoc {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type      String // registration | insurance | inspection | green_card | other
  label     String?
  number    String?
  issuedOn  DateTime?
  expiresOn DateTime?
  fileUrl   String?
  createdAt DateTime  @default(now())

  @@index([expiresOn])
}

/// Échéancier de financement (onglet Paiements du registre véhicules).
model VehiclePayment {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dueOn     DateTime?
  amount    Float?
  principal Float?
  interest  Float?
  balance   Float?

  @@index([vehicleId, dueOn])
}

model Insurance {
  id             String    @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id])
  provider       String?
  contractNumber String?
  monthlyAmount  Float?
  annualAmount   Float?
  effectiveOn    DateTime?
  renewalOn      DateTime?
  paymentMode    String?
  note           String?
  createdAt      DateTime  @default(now())

  @@index([renewalOn])
}

/// PV / amende (onglet "Détail PV").
model Fine {
  id          String    @id @default(cuid())
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  plateRaw    String?
  date        DateTime?
  time        String?
  reference   String?
  payTo       String?
  street      String?
  postalCode  String?
  type        String?
  amount      Float?
  reminder1On DateTime?
  reminder2On DateTime?
  status      String? // "Payé" | null
  note        String?
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────── Fil de chantier

model Thread {
  id         String    @id @default(cuid())
  kind       String    @default("worksite") // worksite | general (fil unique "Général JJD", pas de worksiteId)
  worksiteId String?   @unique // absent pour le fil général
  worksite   Worksite? @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  messages     Message[]
  participants ThreadParticipant[]
  reads        ThreadRead[]
}

model ThreadParticipant {
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([threadId, personId])
}

/// Dernière lecture d'un fil par un utilisateur — par audience, puisqu'un même Thread mélange
/// messages internes et client (cf. Message.audience) : lire la discussion d'équipe ne doit pas
/// marquer comme lus les messages du client, et inversement.
model ThreadRead {
  threadId   String
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  audience   String // internal | client
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())

  @@id([threadId, audience, userId])
}

model Message {
  id               String   @id @default(cuid())
  threadId         String
  thread           Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation(fields: [authorId], references: [id])
  authorName       String? // nom figé (l'auteur peut être un ouvrier sans compte)
  kind             String   @default("text") // text | photo | video | file | status
  body             String?
  fileUrl          String?
  thumbUrl         String?
  source           String? // "whatsapp" | null (créé dans l'app)
  audience         String   @default("internal") // "internal" (équipe) | "client"
  sharedWithClient Boolean  @default(false) // photo/vidéo interne explicitement partagée avec le client
  createdAt        DateTime @default(now())

  mentions MessageMention[]

  @@index([threadId, createdAt])
}

/// "@Nom" dans un message — un utilisateur interne mentionné, pour le mettre en avant dans
/// le fil et déclencher une notification push ciblée (voir PushSubscription).
model MessageMention {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([messageId])
}

/// Abonnement Web Push (navigateur) d'un utilisateur — un même compte peut être abonné
/// depuis plusieurs appareils/navigateurs (endpoint = identifiant unique par abonnement).
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

/// Rapport d'intervention rempli sur le terrain par l'ouvrier / le chef,
/// signé au doigt par le client sur place.
model WorksiteReport {
  id           String    @id @default(cuid())
  worksiteId   String
  worksite     Worksite  @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  eventId      String? // créneau de planning concerné
  authorId     String? // User (chef / ouvrier lié à un compte)
  author       User?     @relation("ReportAuthor", fields: [authorId], references: [id])
  authorName   String
  date         DateTime  @default(now())
  workDone     String? // travaux réalisés
  notes        String? // remarques, réserves
  status       String    @default("draft") // draft | signed — signature client, ne change pas après coup
  clientName   String? // nom de la personne qui a signé
  signatureUrl String? // PNG de la signature (uploads/…)
  signedAt     DateTime?
  // Relecture interne (bureau/chef de chantier) une fois le rapport signé — indépendante de la
  // signature client : le client a déjà vu/signé sur place, ceci ne fait que tracer le contrôle
  // qualité côté JJD (complétude, photos, formulation) et ne rouvre jamais le rapport au client.
  reviewStatus String    @default("pending") // pending | approved | needs_info
  reviewNote   String? // motif si "à compléter"
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("ReportReviewer", fields: [reviewedById], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photos ReportPhoto[]

  @@index([worksiteId])
}

model ReportPhoto {
  id        String         @id @default(cuid())
  reportId  String
  report    WorksiteReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  url       String
  thumbUrl  String?
  caption   String?
  createdAt DateTime       @default(now())

  @@index([reportId])
}

/// Phase / groupe de tâches d'un chantier (ex. "Gros-oeuvre", "Finitions") — façon TrustUp.
/// Une tâche sans phase reste valide ("Tâches sans phase", même libellé que TrustUp).
model WorksiteTaskPhase {
  id         String         @id @default(cuid())
  worksiteId String
  worksite   Worksite       @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  name       String
  position   Int            @default(0)
  createdAt  DateTime       @default(now())
  tasks      WorksiteTask[]

  @@index([worksiteId])
}

/// Tâche d'un chantier — checklist façon TrustUp.
model WorksiteTask {
  id          String             @id @default(cuid())
  worksiteId  String? // absent = tâche générale (administratif, pas de chantier)
  worksite    Worksite?          @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  phaseId     String? // groupe d'affichage au sein du chantier ; absent = "Tâches sans phase"
  phase       WorksiteTaskPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  title       String
  description String? // consignes libres (accès, zone concernée, précautions, résultat attendu…)
  status      String             @default("todo") // todo | doing | done
  priority    String             @default("normal") // low | normal | high | urgent
  checklist   Json? // [{ label, done }] — points à vérifier, cochables indépendamment du statut
  assigneeId  String? // legacy — remplacé par `assignees` (multi), retiré une fois le rattrapage fait
  assignee    Person?            @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assignees   TaskAssignment[]
  dueOn       DateTime?
  position    Int                @default(0)
  createdById String?
  createdBy   User?              @relation("TaskCreatedBy", fields: [createdById], references: [id])
  doneAt      DateTime?
  doneByName  String?
  source      String? // "ai-draft" = proposée par l'assistant IA · "quote" = générée depuis un devis
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([worksiteId])
  @@index([phaseId])
  @@index([status])
}

/// Assignation multi-personnes d'une tâche — sur `Person` (l'équipe, foreman/worker/office…),
/// comme les affectations planning (`EventAssignment`). Couvre aussi le bureau (rôle `office`
/// sur `Person`) sans obliger chaque ouvrier à avoir un compte de connexion.
model TaskAssignment {
  taskId   String
  task     WorksiteTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  personId String
  person   Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
}

// ─────────────────────────────────────────────────────────── Stock de matériaux

/// Article du dépôt de matériaux (distinct du parc d'outillage Bricoloc géré ailleurs).
/// La quantité et le coût moyen pondéré sont dénormalisés ici pour la lecture rapide,
/// recalculés à chaque mouvement (StockMovement) — jamais modifiés directement.
model StockItem {
  id        String   @id @default(cuid())
  ref       String? @unique // référence interne (ART-0001), générée à la création
  name      String
  brand     String? // marque / fabricant (Knauf…)
  model     String? // référence fabricant (MP75…) — le nom complet reste dans `name` (« KNAUF MP75 25KG »)
  note      String?
  unit      String // unité de base du stock ("kg" | "m²" | "u" | "L" | …) — les quantités sont stockées dans cette unité
  category  String?
  minQty    Float? // seuil d'alerte réappro
  qty       Float    @default(0)
  avgCost   Float? // coût unitaire moyen pondéré (mis à jour sur chaque entrée)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]
  units     StockItemUnit[]
  suppliers StockSupplier[]
  barcodes  StockBarcode[]
  orderLines    StockOrderLine[]
  purchaseLines PurchaseOrderLine[]

  @@index([active])
}

/// Unité alternative d'un article, avec son facteur de conversion vers l'unité de base
/// (ex. article en kg : « sac » = 25). L'unité de base elle-même est `StockItem.unit` (facteur 1).
model StockItemUnit {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  name        String // "sac", "pcs", "palette"…
  factor      Float // combien d'unités de base dans 1 de cette unité
  position    Int       @default(0)

  @@unique([stockItemId, name])
}

/// Préparation de commande pour un chantier : le bureau la crée, le magasinier la prépare en
/// scannant chaque article (picking) ; la validation génère les sorties de stock vers le chantier.
model StockOrder {
  id           String           @id @default(cuid())
  ref          String           @unique // PREP-2026-001
  worksiteId   String
  worksite     Worksite         @relation("StockOrderWorksite", fields: [worksiteId], references: [id])
  status       String           @default("to_prepare") // to_prepare | preparing | prepared | cancelled
  neededOn     DateTime? // pour quand le chantier en a besoin
  note         String?
  createdById  String?
  preparedById String?
  preparedBy   String? // nom affiché de celui qui a préparé
  preparedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lines        StockOrderLine[]

  @@index([status])
  @@index([worksiteId])
}

model StockOrderLine {
  id          String     @id @default(cuid())
  orderId     String
  order       StockOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem  @relation(fields: [stockItemId], references: [id])
  unitName    String? // unité de la ligne (sac) ; vide = unité de base
  qty         Float // demandé, dans l'unité de la ligne
  pickedQty   Float      @default(0) // préparé, dans l'unité de la ligne
  note        String?
  position    Int        @default(0)

  @@index([orderId])
}

/// Commande fournisseur : créée au bureau, réceptionnée par le magasinier (scan) quand elle arrive.
model PurchaseOrder {
  id          String              @id @default(cuid())
  ref         String              @unique // CF-2026-001
  contactId   String
  contact     Contact             @relation("PurchaseOrderSupplier", fields: [contactId], references: [id])
  worksiteId  String? // chantier pour lequel on commande (information)
  worksite    Worksite?           @relation("PurchaseOrderWorksite", fields: [worksiteId], references: [id])
  status      String              @default("ordered") // draft | ordered | partial | received | cancelled
  orderedOn   DateTime?
  expectedOn  DateTime?
  supplierRef String? // n° de commande / bon de livraison chez le fournisseur
  note        String?
  createdById String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       PurchaseOrderLine[]

  @@index([status])
  @@index([contactId])
}

model PurchaseOrderLine {
  id          String        @id @default(cuid())
  orderId     String
  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem     @relation(fields: [stockItemId], references: [id])
  unitName    String? // unité de commande ; vide = unité de base
  qty         Float // commandé, dans l'unité de la ligne
  price       Float? // prix HT par unité de commande
  receivedQty Float         @default(0) // déjà réceptionné, dans l'unité de la ligne
  position    Int           @default(0)

  @@index([orderId])
}

/// Code-barres (EAN du sac, étiquette interne…) qui identifie cet article — et éventuellement
/// un conditionnement précis (le code du sac = 1 sac). Un scan retrouve l'article et l'unité.
model StockBarcode {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  code        String    @unique
  unitName    String? // vide = unité de base
  note        String?
  createdAt   DateTime  @default(now())

  @@index([stockItemId])
}

/// Un fournisseur chez qui on peut acheter cet article (plusieurs possibles), avec sa
/// référence, son conditionnement d'achat et son prix.
model StockSupplier {
  id          String    @id @default(cuid())
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  contactId   String
  contact     Contact   @relation("StockSupplierContact", fields: [contactId], references: [id])
  supplierRef String? // référence chez le fournisseur
  unitName    String? // unité d'achat (sac, pcs…) ; vide = unité de base
  price       Float? // prix HT par unité d'achat
  preferred   Boolean   @default(false)
  note        String?
  updatedAt   DateTime  @updatedAt

  @@unique([stockItemId, contactId, unitName])
  @@index([contactId])
}

/// Bon d'entrée / de sortie / d'inventaire. Historique immuable (jamais modifié après coup,
/// une correction se fait par un nouveau mouvement — comme un grand livre).
model StockMovement {
  id              String    @id @default(cuid())
  stockItemId     String
  stockItem       StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type            String // "in" (entrée) | "out" (sortie chantier) | "adjustment" (inventaire)
  qty             Float // en unité de base de l'article, toujours positive ; le sens est donné par `type`
  enteredQty      Float? // quantité saisie dans l'unité choisie (ex. 4)
  enteredUnit     String? // unité choisie (ex. « sac ») — qty = enteredQty × facteur
  contactId       String? // fournisseur (entrée)
  contact         Contact?  @relation("StockMovementSupplier", fields: [contactId], references: [id])
  unitCost        Float? // par unité de base ; renseigné sur une entrée, alimente le coût moyen pondéré
  worksiteId      String? // obligatoire pour une sortie
  worksite        Worksite? @relation(fields: [worksiteId], references: [id])
  requestedByName String? // « le demandeur » (personne qui reçoit la sortie sur chantier)
  note            String?
  createdById     String?
  createdBy       User?     @relation("StockMovementBy", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())

  @@index([stockItemId, createdAt])
  @@index([worksiteId])
}

// ─────────────────────────────────────────────────────────── Import & contrôle

/// Un passage d'import (Excel ou TrustUp).
model ImportBatch {
  id         String    @id @default(cuid())
  source     String // "xlsx" | "trustup"
  label      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  stats      Json?

  issues ImportIssue[]
}

/// Ligne de la "file de contrôle" : donnée douteuse à trancher par David/Melvina.
model ImportIssue {
  id           String      @id @default(cuid())
  batchId      String
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entity       String // "worksite" | "ledger" | "time_entry" | "contact" | ...
  sheet        String?
  rowRef       String?
  severity     String      @default("warning") // info | warning | error
  message      String
  rawData      Json?
  resolved     Boolean     @default(false)
  resolvedNote String?
  createdAt    DateTime    @default(now())

  @@index([entity])
  @@index([resolved])
  @@index([severity])
}
