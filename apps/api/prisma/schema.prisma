// JJD App — schéma de données unique (web bureau, mobile terrain, portail client).
// SQLite en dev ; migrable vers PostgreSQL sans changement de modèle.
// SQLite ne supporte pas les enums Prisma -> les "enums" sont des String,
// validées par les unions de @jjd/shared (voir packages/shared/src/enums.ts).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Compteurs atomiques : numéros de chantier (R-), devis (D-), factures (F-).
model Counter {
  name  String @id
  value Int    @default(0)
}

/// Paramètres éconos + coordonnées société, éditables en admin.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/// Piste d'audit : qui a fait quoi.
model AuditLog {
  id       String   @id @default(cuid())
  at       DateTime @default(now())
  actorId  String?
  actor    User?    @relation(fields: [actorId], references: [id])
  action   String
  entity   String
  entityId String?
  meta     Json?

  @@index([entity, entityId])
  @@index([at])
}

// ─────────────────────────────────────────────────────────── Utilisateurs & équipe

/// Compte de connexion. `role` = admin | office | foreman | worker | client.
/// `isPartner` = David & Julien uniquement (visibilité du partage des bénéfices).
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("worker")
  isPartner    Boolean   @default(false)
  locale       String    @default("fr")
  active       Boolean   @default(true)
  personId     String?   @unique
  person       Person?   @relation(fields: [personId], references: [id])
  contactId    String?   @unique // pour les comptes "client"
  contact      Contact?  @relation(fields: [contactId], references: [id])
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())

  auditLogs       AuditLog[]
  approvedEntries TimeEntry[]      @relation("ApprovedBy")
  ownedOpps       CrmOpportunity[] @relation("OppOwner")
  createdEvents   PlanningEvent[]  @relation("EventCreatedBy")
  messages        Message[]
}

/// Fiche personne : ouvrier ou chef de chantier. Toutes les infos utiles.
model Person {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String?
  displayName      String? // nom court utilisé sur le terrain / dans le pointage
  normalizedName   String // pour le dédoublonnage
  role             String   @default("worker") // foreman | worker
  contractType     String   @default("employee") // employee | subcontractor | interim
  hourlyRate       Float?
  phone            String?
  email            String?
  address          String?
  languages        Json? // ["fr","pt","es"]
  emergencyContact String?
  active           Boolean  @default(true)
  note             String?
  source           String? // "xlsx" | "trustup" | "manual"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?
  legalDocs        LegalDoc[]
  equipment        Equipment[]
  timeEntries      TimeEntry[]
  managedWorksites Worksite[]        @relation("WorksiteManager")
  eventAssignments EventAssignment[]
  teamMemberships  TeamMember[]

  @@index([normalizedName])
  @@index([active])
}

/// Document légal suivi sur une fiche personne (avec échéance -> alerte).
model LegalDoc {
  id        String    @id @default(cuid())
  personId  String
  person    Person    @relation(fields: [personId], references: [id], onDelete: Cascade)
  type      String // id_card | work_permit | a1 | limosa | vca | driving_license | medical | contract | other
  label     String?
  number    String?
  issuedOn  DateTime?
  expiresOn DateTime?
  fileUrl   String?
  createdAt DateTime  @default(now())

  @@index([expiresOn])
}

/// Matériel confié (léger — inventaire complet plus tard si besoin).
model Equipment {
  id           String   @id @default(cuid())
  name         String
  reference    String?
  assignedToId String?
  assignedTo   Person?  @relation(fields: [assignedToId], references: [id])
  note         String?
  createdAt    DateTime @default(now())
}

/// Équipe = préréglage nommé (souvent recomposé au jour le jour via le planning).
model Team {
  id      String          @id @default(cuid())
  name    String
  color   String?
  active  Boolean         @default(true)
  members TeamMember[]
  events  PlanningEvent[]
}

model TeamMember {
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  personId String
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([teamId, personId])
}

// ─────────────────────────────────────────────────────────── Clients & immeubles

/// Syndic (Baltimo, Kadaner, Citya Woluwe…). Regroupe des immeubles / ACP.
model Syndic {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  email          String?
  phone          String?
  address        String?
  city           String?
  note           String?
  createdAt      DateTime @default(now())

  buildings Building[]
  contacts  Contact[]

  @@index([normalizedName])
}

/// Contact : client (particulier, société, ACP, pouvoir public) ou fournisseur.
model Contact {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  type           String   @default("client") // client | supplier | both
  kind           String? // individual | company | acp | syndic | public
  email          String?
  phone          String?
  vat            String?
  address        String?
  postalCode     String?
  city           String?
  syndicId       String?
  syndic         Syndic?  @relation(fields: [syndicId], references: [id])
  note           String?
  trustupId      String?
  source         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user          User?
  worksites     Worksite[]       @relation("WorksiteClient")
  buildings     Building[]
  opportunities CrmOpportunity[]
  documents     Document[]
  ledgerEntries LedgerEntry[]

  @@index([normalizedName])
  @@index([type])
}

/// Immeuble / ACP — le "dossier principal" du portail client.
model Building {
  id             String   @id @default(cuid())
  name           String
  normalizedName String
  address        String?
  postalCode     String?
  city           String?
  syndicId       String?
  syndic         Syndic?  @relation(fields: [syndicId], references: [id])
  clientId       String?
  client         Contact? @relation(fields: [clientId], references: [id])
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  worksites     Worksite[]
  opportunities CrmOpportunity[]

  @@index([normalizedName])
}

// ─────────────────────────────────────────────────────────── Chantiers & CRM

/// Chantier — le pivot. `ref` = R-xxx (unique, attribué automatiquement).
model Worksite {
  id          String    @id @default(cuid())
  ref         String    @unique
  title       String
  kind        String    @default("project") // project | overhead (codes E-xx : frais sans chantier)
  entity      String    @default("jjd") // jjd | tonton | m7
  status      String    @default("to_plan")
  statusRaw   String? // texte d'origine (Excel / TrustUp)
  statusTags  Json? // ["Terminé","A vérifier"]
  clientId    String?
  client      Contact?  @relation("WorksiteClient", fields: [clientId], references: [id])
  buildingId  String?
  building    Building? @relation(fields: [buildingId], references: [id])
  managerId   String?
  manager     Person?   @relation("WorksiteManager", fields: [managerId], references: [id])
  billTo      String? // "Facture à" texte libre du fichier (à rapprocher)
  address     String?
  postalCode  String?
  city        String?
  startedOn   DateTime?
  endedOn     DateTime?
  quotedHt    Float? // "Total Devisé"
  description String?
  trustupId   String?
  source      String?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  documents     Document[]
  ledgerEntries LedgerEntry[]
  timeEntries   TimeEntry[]
  events        PlanningEvent[]
  opportunity   CrmOpportunity?
  thread        Thread?

  @@index([status])
  @@index([entity])
  @@index([ref])
}

/// Opportunité commerciale — le pipeline CRM.
model CrmOpportunity {
  id             String    @id @default(cuid())
  title          String
  stage          String    @default("new") // new | to_qualify | visit_scheduled | quote_sent | follow_up | won | lost
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  buildingId     String?
  building       Building? @relation(fields: [buildingId], references: [id])
  worksiteId     String?   @unique
  worksite       Worksite? @relation(fields: [worksiteId], references: [id])
  ownerId        String?
  owner          User?     @relation("OppOwner", fields: [ownerId], references: [id])
  estimatedValue Float?
  source         String? // "portail" | "site" | "téléphone" | "recommandation"
  nextActionOn   DateTime?
  nextActionNote String?
  lostReason     String?
  note           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([stage])
  @@index([nextActionOn])
}

// ─────────────────────────────────────────────────────────── Facturation & compta

/// Catégorie comptable (codes E-01…E-19 + libellés de charges/revenus).
model Category {
  code   String  @id
  label  String
  kind   String // revenue | expense | salary | vat | tax | credit_note | internal
  entity String? // rattachement éventuel (jjd | tonton | m7)
  active Boolean @default(true)

  ledgerEntries LedgerEntry[]
}

/// En-tête de document commercial : devis, facture, note de crédit, acompte.
/// Source de vérité = TrustUp pour l'instant (import). Le module lot 6 les créera.
model Document {
  id         String    @id @default(cuid())
  kind       String // quote | invoice | credit_note | deposit_invoice
  direction  String    @default("sale") // sale | purchase | credit_note
  number     String
  worksiteId String?
  worksite   Worksite? @relation(fields: [worksiteId], references: [id])
  contactId  String?
  contact    Contact?  @relation(fields: [contactId], references: [id])
  status     String    @default("draft")
  title      String?
  issuedOn   DateTime?
  dueOn      DateTime?
  totalHt    Float     @default(0)
  totalVat   Float     @default(0)
  totalTtc   Float     @default(0)
  vatRate    Float?
  paidAmount Float     @default(0)
  paidOn     DateTime?
  note       String?
  trustupId  String?
  source     String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([kind, number])
  @@index([worksiteId])
  @@index([status])
}

/// Ligne du grand livre = une ligne de l'onglet "Facture" du fichier.
/// C'est la granularité qui alimente la marge réelle (matériaux) et le CA.
model LedgerEntry {
  id            String    @id @default(cuid())
  date          DateTime?
  year          Int?
  month         String?
  direction     String // sale | purchase | credit_note
  docType       String? // "Facture de vente" | "Facture d'achat" | "Note de crédit"
  docNumber     String?
  worksiteRef   String? // R-xxx / E-xx tel qu'écrit
  worksiteId    String?
  worksite      Worksite? @relation(fields: [worksiteId], references: [id])
  supplierName  String?
  contactId     String?
  contact       Contact?  @relation(fields: [contactId], references: [id])
  categoryCode  String?
  category      Category? @relation(fields: [categoryCode], references: [code])
  categoryRaw   String?
  ht            Float     @default(0)
  vatRecup      Float?
  vatDue        Float?
  ttc           Float?
  vatRate       Float?
  quarter       String?
  paymentStatus String? // "Payé" | ...
  bankComm      String?
  source        String?
  createdAt     DateTime  @default(now())

  @@index([worksiteId])
  @@index([worksiteRef])
  @@index([direction])
  @@index([date])
}

/// Import brut des relevés bancaires (Belfius + ING). Rapprochement progressif.
model BankTransaction {
  id                  String    @id @default(cuid())
  bookingDate         DateTime?
  bank                String?
  counterpartyAccount String?
  counterpartyName    String?
  description         String?
  valueDate           DateTime?
  amount              Float?
  currency            String?   @default("EUR")
  communication       String?
  matchedLedgerId     String?
  source              String?
  createdAt           DateTime  @default(now())

  @@index([bookingDate])
}

// ─────────────────────────────────────────────────────────── Pointage & planning

/// Pointage = une ligne de l'onglet "Main doeuvre" / un run du compteur mobile.
model TimeEntry {
  id            String    @id @default(cuid())
  personId      String
  person        Person    @relation(fields: [personId], references: [id])
  worksiteId    String?
  worksite      Worksite? @relation(fields: [worksiteId], references: [id])
  worksiteRef   String?
  date          DateTime?
  hours         Float?
  amount        Float? // heures × taux, ou saisi à la main
  rateUsed      Float?
  task          String?
  startedAt     DateTime? // compteur mobile
  endedAt       DateTime?
  status        String    @default("approved") // running | submitted | approved | rejected
  approvedById  String?
  approvedBy    User?     @relation("ApprovedBy", fields: [approvedById], references: [id])
  subcontractor String?
  source        String?
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([personId, date])
  @@index([worksiteId])
  @@index([status])
}

/// Événement de planning : équipe + véhicule affectés à un chantier.
model PlanningEvent {
  id            String   @id @default(cuid())
  worksiteId    String
  worksite      Worksite @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  title         String?
  startAt       DateTime
  endAt         DateTime
  allDay        Boolean  @default(false)
  teamId        String?
  team          Team?    @relation(fields: [teamId], references: [id])
  vehicleId     String?
  vehicle       Vehicle? @relation(fields: [vehicleId], references: [id])
  materialsNote String?
  note          String?
  googleEventId String?
  createdById   String?
  createdBy     User?    @relation("EventCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assignments EventAssignment[]

  @@index([startAt])
  @@index([worksiteId])
}

model EventAssignment {
  eventId  String
  event    PlanningEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId String
  person   Person        @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([eventId, personId])
}

// ─────────────────────────────────────────────────────────── Flotte

model Vehicle {
  id                String    @id @default(cuid())
  code              String?   @unique // V002, V003… (registre JJD)
  plate             String?
  brand             String?
  model             String?
  name              String?
  type              String?   // Camionette | Moto | Clark | Voiture
  fuel              String?
  vin               String?
  firstRegistration DateTime?
  km                String?
  nextInspection    DateTime?
  circulationTax    Float?
  biv               Float?
  driver            String?
  equipment         String?
  depot             String?
  status            String    @default("active")

  // acquisition / financement
  acquisitionMode   String?   // Comptant | Crédit | Leasing | Renting financier
  purchaseDate      DateTime?
  purchasePriceHt   Float?
  financedAmount    Float?
  monthlyPayment    Float?
  downPayment       Float?
  residualValue     Float?
  financeMonths     Int?
  financeEndOn      DateTime?
  financeCompany    String?
  financeContract   String?

  active            Boolean   @default(true)
  note              String?
  source            String?
  createdAt         DateTime  @default(now())

  insurances Insurance[]
  fines      Fine[]
  events     PlanningEvent[]
  payments   VehiclePayment[]
}

/// Échéancier de financement (onglet Paiements du registre véhicules).
model VehiclePayment {
  id        String    @id @default(cuid())
  vehicleId String
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dueOn     DateTime?
  amount    Float?
  principal Float?
  interest  Float?
  balance   Float?

  @@index([vehicleId, dueOn])
}

model Insurance {
  id             String    @id @default(cuid())
  vehicleId      String?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id])
  provider       String?
  contractNumber String?
  monthlyAmount  Float?
  annualAmount   Float?
  effectiveOn    DateTime?
  renewalOn      DateTime?
  paymentMode    String?
  note           String?
  createdAt      DateTime  @default(now())

  @@index([renewalOn])
}

/// PV / amende (onglet "Détail PV").
model Fine {
  id          String    @id @default(cuid())
  vehicleId   String?
  vehicle     Vehicle?  @relation(fields: [vehicleId], references: [id])
  plateRaw    String?
  date        DateTime?
  time        String?
  reference   String?
  payTo       String?
  street      String?
  postalCode  String?
  type        String?
  amount      Float?
  reminder1On DateTime?
  reminder2On DateTime?
  status      String? // "Payé" | null
  note        String?
  createdAt   DateTime  @default(now())

  @@index([status])
}

// ─────────────────────────────────────────────────────────── Fil de chantier

model Thread {
  id         String    @id @default(cuid())
  worksiteId String    @unique
  worksite   Worksite  @relation(fields: [worksiteId], references: [id], onDelete: Cascade)
  closedAt   DateTime?
  createdAt  DateTime  @default(now())

  messages     Message[]
  participants ThreadParticipant[]
}

model ThreadParticipant {
  threadId String
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  personId String

  @@id([threadId, personId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  kind      String   @default("text") // text | photo | status
  body      String?
  fileUrl   String?
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

// ─────────────────────────────────────────────────────────── Import & contrôle

/// Un passage d'import (Excel ou TrustUp).
model ImportBatch {
  id         String    @id @default(cuid())
  source     String // "xlsx" | "trustup"
  label      String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  stats      Json?

  issues ImportIssue[]
}

/// Ligne de la "file de contrôle" : donnée douteuse à trancher par David/Melvina.
model ImportIssue {
  id           String      @id @default(cuid())
  batchId      String
  batch        ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  entity       String // "worksite" | "ledger" | "time_entry" | "contact" | ...
  sheet        String?
  rowRef       String?
  severity     String      @default("warning") // info | warning | error
  message      String
  rawData      Json?
  resolved     Boolean     @default(false)
  resolvedNote String?
  createdAt    DateTime    @default(now())

  @@index([entity])
  @@index([resolved])
  @@index([severity])
}
