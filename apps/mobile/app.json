{
  "expo": {
    "name": "JJD Chantier",
    "slug": "jjd-chantier",
    "owner": "jjd-consult",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "jjd",
    "userInterfaceStyle": "light",
    "primaryColor": "#173f34",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "be.jjdconsult.chantier",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "be.jjdconsult.chantier",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#102f27"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "JJD Chantier accède à vos photos pour les ajouter au fil du chantier.",
          "cameraPermission": "JJD Chantier utilise l’appareil photo pour les photos de chantier et les justificatifs."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "JJD Chantier utilise votre position pour vérifier que le pointage est bien fait sur le chantier."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "imageWidth": 160,
          "backgroundColor": "#102f27",
          "resizeMode": "contain"
        }
      ],
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "JJD Chantier utilise l’appareil photo pour scanner les codes du matériel.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "JJD Chantier utilise le microphone uniquement lorsque vous enregistrez une note vocale.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#173f34",
          "defaultChannel": "jjd"
        }
      ]
    ],
    "extra": {
      "apiUrl": "https://new.jjd-consult.be/jjd-api",
      "router": {},
      "eas": {
        "projectId": "74479c66-ed24-4f35-b3dd-3c4b02068a12"
      }
    }
  }
}
