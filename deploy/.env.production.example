# ─────────────────────────────────────────────────────────────────────────────
#  JJD — configuration de production (VPS Combell, à côté de Bricoloc)
#  Copier vers  .env.production  à la racine, puis compléter. Ne jamais committer.
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public. L'app Next sert le site + /app + /portail ; l'API est sous /jjd-api.
# Phase de test : sous-domaine dédié. Bascule finale vers jjd-consult.be plus tard.
SITE_URL=https://new.jjd-consult.be

# Base PostgreSQL (interne au réseau Docker, pas exposée).
POSTGRES_USER=jjd
POSTGRES_PASSWORD=CHANGER_ce_mot_de_passe_long
POSTGRES_DB=jjd

# Secret de signature des jetons. Générer :  openssl rand -hex 32
JWT_SECRET=CHANGER_par_une_valeur_aleatoire_de_64_caracteres

# Traduction auto NL/EN (optionnel).
DEEPL_API_KEY=

# Google Agenda (optionnel — déposer secrets/google-sa.json + partager l'agenda).
GOOGLE_CALENDAR_ID=

# ─── Parc d'outillage partagé avec Bricoloc ───
# BRICOLOC_API_KEY doit être IDENTIQUE à PARTNER_API_KEY du .env.production de Bricoloc.
BRICOLOC_API_URL=https://new.bricoloc.be/bricoloc-api
BRICOLOC_API_KEY=

# ─── Connexion bancaire Ponto (optionnel — voir docs/ponto.md) ───
# Une fois en prod, l'URL de callback publique devient possible.
PONTO_CLIENT_ID=
PONTO_CLIENT_SECRET=
PONTO_KEY_PASSPHRASE=
# (les certificats vivent dans apps/api/secrets/, montés en lecture seule)
